# Copy to .env and adjust. Every setting is optional.

# Where the server listens. Use HOST=0.0.0.0 to accept connections from other machines.
PORT=3000
HOST=127.0.0.1

# Public address of the site, used for sitemap.xml, RSS and link previews.
# PUBLIC_URL=https://robinpark.dev

# Admin password. If unset, the server uses data/auth.json (see `npm run site -- set-password`),
# or generates a password on first start and prints it once.
# ADMIN_PASSWORD=change-me

# Secret used to sign admin sessions. Generated into data/secret.key if unset.
# SESSION_SECRET=

# Where content, uploads, demo files and backups live.
# DATA_DIR=./data

# Set to true behind a reverse proxy (Caddy, nginx) so rate limits see real visitor IPs.
# TRUST_PROXY=false

# Playground demos
# DOCKER_BIN=docker
# RUN_MAX_CONCURRENT=2        # playground runs at the same time
# RUN_RATE_LIMIT=30           # runs per visitor per 10 minutes
# RUN_MAX_INPUT_KB=100        # largest input a visitor may submit

# Largest single upload (media or demo file), in megabytes.
# MAX_UPLOAD_MB=50

# Origins allowed to call the public API (demo runs, public content). Use * or a comma-separated list.
# CORS_ORIGINS=*
